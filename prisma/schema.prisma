
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SaleMode {
  DIRECT
  QUOTE
}

enum Material {
  PLA
  PETG
  TPU
  OTHER
}

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
  CLOSED
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique

  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryHierarchy")

  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String           @db.Text
  shortDescription String? @db.Text
  seoTitle String?
  seoDescription String? @db.Text
  seoKeywords String? @db.Text
  socialTitle String?
  socialDescription String? @db.Text
  socialImageUrl String?
  status      ProductStatus    @default(DRAFT)
  saleMode    SaleMode         @default(DIRECT)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sourcePlatform       String?
  sourceModelId        String?
  sourceUrl            String?
  sourceDesigner       String?
  sourceLicense        String?
  commercialPermission Boolean @default(false)
  rightsEvidence   String?   @db.Text
  rightsReviewedAt DateTime?
  designOrigin DesignOrigin @default(OWN)
  quoteRequests QuoteRequest[]

  @@index([status, categoryId])
  @@unique([sourcePlatform, sourceModelId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)

  @@index([productId, position])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  label          String
  material       Material @default(PLA)
  color          String
  weightGrams    Int // Peso total estimado por Bambu Studio, incluidos soportes/purgas
  weightCentigrams Int?
  priceCents     Int // Precio final editable en céntimos; no usar Float para dinero
  productionMins Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId, active])
}

model PricingConfig {
  id               String   @id @default("default")
  baseCentsPerGram Int      @default(12) // 12 céntimos/g. Cambiable en panel.
  minimumCents     Int      @default(0) // Sin mínimo hasta acuerdo comercial.
  updatedAt        DateTime @updatedAt
}

model QuoteRequest {
  id           String      @id @default(cuid())
  customerName String
  email        String
  notes        String?     @db.Text
  fileKey      String? // Ruta privada; NUNCA URL pública del STL del cliente.
  status       QuoteStatus @default(NEW)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  internalNotes QuoteInternalNote[]

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  quoteRequests QuoteRequest[]
  customerProfile CustomerProfile?
  orders Order[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  impersonatedBy String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum SavedDesignStatus {
  TO_REVIEW
  SHORTLIST
  DISCARDED
}

enum DesignOrigin {
  OWN
  CUSTOM
  THIRD_PARTY
}

model SavedDesign {
  id         String            @id @default(cuid())
  platform   String
  externalId String
  title      String
  designer   String
  license    String
  sourceUrl  String
  status     SavedDesignStatus @default(TO_REVIEW)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([platform, externalId])
  @@index([status, createdAt])
}


model CustomerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName          String   @default("")
  lastName           String   @default("")
  phone              String   @default("")

  shippingAddress    String   @default("")
  shippingPostalCode String   @default("")
  shippingCity       String   @default("")
  shippingProvince   String   @default("")
  shippingCountry    String   @default("España")

  billingAddress     String   @default("")
  billingPostalCode  String   @default("")
  billingCity        String   @default("")
  billingProvince    String   @default("")
  billingCountry     String   @default("España")

  taxId              String   @default("")
  updatedAt          DateTime @updatedAt
}


model QuoteInternalNote {
  id               String       @id @default(cuid())
  quoteId          String
  quote            QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  authorId         String
  authorName       String
  body             String       @db.Text

  statusFrom       QuoteStatus
  statusTo         QuoteStatus

  reference        String?
  amountCents      Int?
  itemsSummary     String?
  deliveryEstimate String?
  sentToCustomer   Boolean      @default(false)

  createdAt        DateTime     @default(now())

  @@index([quoteId, createdAt])
}

enum OrderStatus {
  RECEIVED
  MANUFACTURING
  FINISHED
  SHIPPED
}

model Order {
  id               String         @id @default(cuid())
  checkoutKey String? @unique
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerName     String
  customerEmail    String
  customerPhone    String         @default("")
  shippingAddress  String         @db.Text
  billingAddress   String         @db.Text
  customerNotes    String         @default("") @db.Text
  totalCents       Int
  status           OrderStatus    @default(RECEIVED)
  paymentStatus    String         @default("PENDING")
  carrier          String?
  trackingNumber   String?
  items            OrderItem[]
  history          OrderHistory[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  productName    String
  variantLabel   String
  sku            String
  material       Material
  color          String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
}

model OrderHistory {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId       String?
  authorName     String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  internalNote   String?      @db.Text
  publicMessage  String?      @db.Text
  createdAt      DateTime     @default(now())
  @@index([orderId, createdAt])
}
